  // Main data fetch routine
  async function fetchData() {
    updateUrl();
    renderActiveFilterChips();

    loadingState.classList.remove('hidden');
    errorState.classList.add('hidden');
    emptyState.classList.add('hidden');
    gridContainer.classList.add('hidden');
    tableView.classList.add('hidden');
    paginationWrapper.classList.add('hidden');

    try {
      if (state.q.trim().length > 0) {
        resultsModeBadge.textContent = 'Search Mode';
        resultsCountText.textContent = `Searching catalog for "${state.q}"...`;

        const searchParams: Record<string, any> = {
          q: state.q.trim()
        };
        if (state.fuel_type) searchParams.fuel_type = state.fuel_type;
        if (state.fuel_state) searchParams.fuel_state = state.fuel_state;
        if (state.gravity_condition) searchParams.gravity_condition = state.gravity_condition;
        if (state.safety_category) searchParams.safety_category = state.safety_category;

        const searchResult = await searchInvestigations(searchParams);
        loadingState.classList.add('hidden');

        const matches = searchResult?.matches || [];
        const count = searchResult?.count ?? matches.length;

        if (count === 0) {
          emptyState.classList.remove('hidden');
          resultsCountText.textContent = `0 matches for "${state.q}"`;
          return;
        }

        resultsCountText.textContent = `Found ${count} ${count === 1 ? 'investigation' : 'investigations'} matching query "${state.q}"`;
        renderView(matches, true);

      } else {
        resultsModeBadge.textContent = 'Listing Mode';
        resultsCountText.textContent = 'Fetching investigations...';

        const listParams: Record<string, any> = {
          limit: state.limit,
          offset: state.offset
        };
        if (state.fuel_state) listParams.fuel_state = state.fuel_state;
        if (state.gravity_condition) listParams.gravity_condition = state.gravity_condition;
        if (state.fuel_type) listParams.fuel_type = state.fuel_type;
        if (state.safety_category) listParams.safety_category = state.safety_category;
        if (state.oxygen_min) listParams.oxygen_min = state.oxygen_min;
        if (state.oxygen_max) listParams.oxygen_max = state.oxygen_max;
        if (state.pressure_min) listParams.pressure_min = state.pressure_min;
        if (state.pressure_max) listParams.pressure_max = state.pressure_max;
        if (state.hardware) listParams.hardware = state.hardware;
        if (state.diluents) listParams.diluents = state.diluents;

        const response = await getInvestigations(listParams);
        loadingState.classList.add('hidden');

        const results = response?.results || [];
        const totalCount = response?.count ?? results.length;

        totalCountLabel.textContent = `${totalCount} Records Cataloged`;

        if (results.length === 0) {
          emptyState.classList.remove('hidden');
          resultsCountText.textContent = '0 investigations found matching criteria';
          return;
        }

        resultsCountText.textContent = `Displaying ${results.length} of ${totalCount} ${totalCount === 1 ? 'investigation' : 'investigations'}`;
        renderView(results, false);

        if (totalCount > state.limit) {
          paginationWrapper.classList.remove('hidden');
          const currentPage = Math.floor(state.offset / state.limit) + 1;
          const totalPages = Math.ceil(totalCount / state.limit);
          paginationInfo.textContent = `Page ${currentPage} of ${totalPages} (${totalCount} total)`;

          prevPageBtn.disabled = state.offset === 0;
          nextPageBtn.disabled = state.offset + state.limit >= totalCount;
        }
      }
    } catch (err: any) {
      loadingState.classList.add('hidden');
      errorState.classList.remove('hidden');
      errorMessage.textContent = err?.message || 'Error occurred while loading investigations from backend.';
      resultsCountText.textContent = 'Error querying catalog';
    }
  }

  // Event Listeners
  // View Switchers
  viewGridBtn?.addEventListener('click', () => {
    state.viewMode = 'grid';
    updateUrl();
    updateViewModeButtons();
  });

  viewTableBtn?.addEventListener('click', () => {
    state.viewMode = 'table';
    updateUrl();
    updateViewModeButtons();
  });

  // Filter Toggle
  filterToggleBtn?.addEventListener('click', () => {
    const isExpanded = filterToggleBtn.getAttribute('aria-expanded') === 'true';
    filterToggleBtn.setAttribute('aria-expanded', String(!isExpanded));
    filterPanel.classList.toggle('hidden');
    if (toggleArrow) {
      toggleArrow.innerHTML = isExpanded ? '&darr;' : '&uarr;';
    }
  });

  // Search Form Submit
  searchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    state.q = searchInput.value.trim();
    state.offset = 0;
    if (clearSearchBtn) {
      if (state.q) clearSearchBtn.classList.remove('hidden');
      else clearSearchBtn.classList.add('hidden');
    }
    fetchData();
  });

  // Clear Search Button
  clearSearchBtn?.addEventListener('click', () => {
    state.q = '';
    searchInput.value = '';
    clearSearchBtn.classList.add('hidden');
    state.offset = 0;
    fetchData();
  });

  // Apply Filters
  applyFiltersBtn?.addEventListener('click', () => {
    state.fuel_state = fuelStateSelect.value;
    state.gravity_condition = gravitySelect.value;
    state.fuel_type = fuelTypeInput.value.trim();
    state.safety_category = safetyInput.value.trim();
    state.oxygen_min = oxygenMinInput.value.trim();
    state.oxygen_max = oxygenMaxInput.value.trim();
    state.pressure_min = pressureMinInput.value.trim();
    state.pressure_max = pressureMaxInput.value.trim();
    state.hardware = hardwareInput.value.trim();
    state.diluents = diluentsInput.value.trim();
    state.offset = 0;
    fetchData();
  });

  // Reset Filters in Panel
  resetFiltersBtn?.addEventListener('click', () => {
    fuelStateSelect.value = '';
    gravitySelect.value = '';
    fuelTypeInput.value = '';
    safetyInput.value = '';
    oxygenMinInput.value = '';
    oxygenMaxInput.value = '';
    pressureMinInput.value = '';
    pressureMaxInput.value = '';
    hardwareInput.value = '';
    diluentsInput.value = '';

    state.fuel_state = '';
    state.gravity_condition = '';
    state.fuel_type = '';
    state.safety_category = '';
    state.oxygen_min = '';
    state.oxygen_max = '';
    state.pressure_min = '';
    state.pressure_max = '';
    state.hardware = '';
    state.diluents = '';
    state.offset = 0;
    fetchData();
  });

  // Reset All Criteria (Search + Filters)
  const resetAll = () => {
    if (searchInput) searchInput.value = '';
    if (clearSearchBtn) clearSearchBtn.classList.add('hidden');
    fuelStateSelect.value = '';
    gravitySelect.value = '';
    fuelTypeInput.value = '';
    safetyInput.value = '';
    oxygenMinInput.value = '';
    oxygenMaxInput.value = '';
    pressureMinInput.value = '';
    pressureMaxInput.value = '';
    hardwareInput.value = '';
    diluentsInput.value = '';

    state.q = '';
    state.fuel_state = '';
    state.gravity_condition = '';
    state.fuel_type = '';
    state.safety_category = '';
    state.oxygen_min = '';
    state.oxygen_max = '';
    state.pressure_min = '';
    state.pressure_max = '';
    state.hardware = '';
    state.diluents = '';
    state.offset = 0;
    fetchData();
  };

  clearAllCriteriaBtn?.addEventListener('click', resetAll);
  emptyResetBtn?.addEventListener('click', resetAll);
  retryBtn?.addEventListener('click', fetchData);

  // Pagination clicks
  prevPageBtn?.addEventListener('click', () => {
    if (state.offset >= state.limit) {
      state.offset -= state.limit;
      fetchData();
    }
  });

  nextPageBtn?.addEventListener('click', () => {
    state.offset += state.limit;
    fetchData();
  });

  // Initialize
  parseUrlParams();
  fetchData();
</script>
