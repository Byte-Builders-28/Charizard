  function formatFuelType(fuel: string | null): string {
    if (!fuel) return '—';
    try {
      if (fuel.startsWith('[') && fuel.endsWith(']')) {
        const parsed = JSON.parse(fuel);
        if (Array.isArray(parsed)) {
          return parsed.join(', ');
        }
      }
    } catch {
      // Fallback
    }
    return fuel;
  }

  function parseCategories(cat: string | null): string[] {
    if (!cat) return [];
    try {
      if (cat.startsWith('[') && cat.endsWith(']')) {
        const parsed = JSON.parse(cat);
        if (Array.isArray(parsed)) return parsed;
      }
    } catch {
      // Fallback
    }
    return [cat];
  }

