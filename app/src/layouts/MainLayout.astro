---
import Navbar from '../components/navigation/Navbar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CHARIZARD | Microgravity Combustion Research Data Explorer',
  description = 'Explore spacecraft combustion investigations, examine experimental conditions, and compare findings from microgravity research.'
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="bg-[#F3F0E8] text-[#202421] min-h-screen flex flex-col font-sans antialiased selection:bg-[#D85A32] selection:text-white">
    <Navbar currentPath={currentPath} />

    <main class="flex-1 w-full">
      <slot />
    </main>

    <footer class="w-full bg-[#FFFFFF] border-t border-[#D8D5CC] mt-auto py-8">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-xs font-mono text-[#666B64]">
          <div>
            <span class="font-bold text-[#202421]">CHARIZARD</span>
            <span class="mx-2 text-[#D8D5CC]">|</span>
            <span>Microgravity Combustion Research Data Explorer</span>
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <a href="/investigations" class="hover:text-[#202421] hover:underline">Investigations</a>
            <a href="/compare" class="hover:text-[#202421] hover:underline">Compare</a>
            <a href="/agent" class="hover:text-[#202421] hover:underline">Research Agent</a>
            <a href="/dataset" class="hover:text-[#202421] hover:underline">Dataset</a>
            <a href="/about" class="hover:text-[#202421] hover:underline">About</a>
          </div>
        </div>
        <div class="mt-4 pt-4 border-t border-[#D8D5CC] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-[11px] font-mono text-[#666B64]">
          <p>Scientific Data Catalog: 11 Investigations &bull; 2,241 Telemetry Rows</p>
          <p>Strict scientific preservation &bull; Verified provenance</p>
        </div>
      </div>
    </footer>
  </body>
</html>
